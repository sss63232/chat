NEXT_PUBLIC_DEFAULT_BACKEND=fastapi
NEXT_PUBLIC_FASTAPI_API_BASE=http://localhost:8000
NEXT_PUBLIC_SPRING_API_BASE=http://localhost:8080

# Feature flags (build-time overrides)
NEXT_PUBLIC_FEATURE_TASK_PANEL=false
NEXT_PUBLIC_FEATURE_STREAMING_RESPONSE=true
NEXT_PUBLIC_FEATURE_NEW_BACKEND_TOGGLE=rollout:0

# Show feature flag admin panel by default in this build
NEXT_PUBLIC_FEATURE_FLAG_ADMIN=false
