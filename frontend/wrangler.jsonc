{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fast-minio",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-28",
	// Serve the static export produced by `npm run build`; /api/* goes to the Worker proxy.
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		"BACKEND_URL": "https://fast-minio-api.onrender.com"
	}
	// INTERNAL_API_TOKEN is a secret: `npx wrangler secret put INTERNAL_API_TOKEN`
}
